<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Modern Color Palette (No AI-slop gradients, high contrast WCAG compliant) -->
    <Color x:Key="BackgroundColor">#0B0F19</Color>
    <Color x:Key="SurfaceColor">#131B2E</Color>
    <Color x:Key="SurfaceAltColor">#1E293B</Color>
    <Color x:Key="SurfaceBorderColor">#28354E</Color>
    <Color x:Key="SurfaceHoverColor">#1E2B48</Color>

    <Color x:Key="PrimaryColor">#4F46E5</Color>
    <Color x:Key="PrimaryHoverColor">#6366F1</Color>
    <Color x:Key="PrimaryPressedColor">#4338CA</Color>

    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <Color x:Key="AccentSuccessColor">#10B981</Color>
    <Color x:Key="AccentWarningColor">#F59E0B</Color>
    <Color x:Key="AccentDangerColor">#EF4444</Color>

    <Color x:Key="UserMessageColor">#3730A3</Color>
    <Color x:Key="AssistantMessageColor">#162035</Color>
    <Color x:Key="CitationBadgeColor">#1E3A8A</Color>
    <Color x:Key="CitationBadgeTextColor">#93C5FD</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorderColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccessColor}" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarningColor}" />
    <SolidColorBrush x:Key="AccentDangerBrush" Color="{StaticResource AccentDangerColor}" />

    <SolidColorBrush x:Key="UserMessageBrush" Color="{StaticResource UserMessageColor}" />
    <SolidColorBrush x:Key="AssistantMessageBrush" Color="{StaticResource AssistantMessageColor}" />
    <SolidColorBrush x:Key="CitationBadgeBrush" Color="{StaticResource CitationBadgeColor}" />
    <SolidColorBrush x:Key="CitationBadgeTextBrush" Color="{StaticResource CitationBadgeTextColor}" />

</ResourceDictionary>
