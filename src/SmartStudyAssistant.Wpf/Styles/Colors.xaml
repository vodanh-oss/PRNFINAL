<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Professional Light Theme Modern Color Palette (High contrast, WCAG compliant, clean and bright) -->
    <Color x:Key="BackgroundColor">#F8FAFC</Color>     <!-- Slate 50: clean soft light background -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>        <!-- Pure White: cards, sidebar -->
    <Color x:Key="SurfaceAltColor">#F1F5F9</Color>     <!-- Slate 100: input fields, sub-panels -->
    <Color x:Key="SurfaceBorderColor">#E2E8F0</Color>  <!-- Slate 200: subtle crisp border -->
    <Color x:Key="SurfaceHoverColor">#E2E8F0</Color>   <!-- Slate 200: hover state -->

    <Color x:Key="PrimaryColor">#2563EB</Color>        <!-- Blue 600: vibrant, confident, professional -->
    <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>   <!-- Blue 700: darker hover -->
    <Color x:Key="PrimaryPressedColor">#1E40AF</Color> <!-- Blue 800: pressed state -->

    <Color x:Key="TextPrimaryColor">#0F172A</Color>    <!-- Slate 900: sharp, crisp dark text -->
    <Color x:Key="TextSecondaryColor">#475569</Color>  <!-- Slate 600: legible secondary text -->
    <Color x:Key="TextMutedColor">#64748B</Color>      <!-- Slate 500: subtle captions -->

    <Color x:Key="AccentSuccessColor">#059669</Color>  <!-- Emerald 600 -->
    <Color x:Key="AccentWarningColor">#D97706</Color>  <!-- Amber 600 -->
    <Color x:Key="AccentDangerColor">#DC2626</Color>   <!-- Red 600 -->

    <Color x:Key="UserMessageColor">#EFF6FF</Color>    <!-- Blue 50: soft pleasant blue for user messages -->
    <Color x:Key="AssistantMessageColor">#FFFFFF</Color><!-- White: clean card for AI assistant -->
    <Color x:Key="CitationBadgeColor">#DBEAFE</Color>  <!-- Blue 100: readable light badge -->
    <Color x:Key="CitationBadgeTextColor">#1D4ED8</Color><!-- Blue 700: dark blue text for badge -->

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorderColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccessColor}" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarningColor}" />
    <SolidColorBrush x:Key="AccentDangerBrush" Color="{StaticResource AccentDangerColor}" />

    <SolidColorBrush x:Key="UserMessageBrush" Color="{StaticResource UserMessageColor}" />
    <SolidColorBrush x:Key="AssistantMessageBrush" Color="{StaticResource AssistantMessageColor}" />
    <SolidColorBrush x:Key="CitationBadgeBrush" Color="{StaticResource CitationBadgeColor}" />
    <SolidColorBrush x:Key="CitationBadgeTextBrush" Color="{StaticResource CitationBadgeTextColor}" />

</ResourceDictionary>
