<UserControl x:Class="SmartStudyAssistant.Wpf.Views.FlashcardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SmartStudyAssistant.Wpf.ViewModels"
             xmlns:helpers="clr-namespace:SmartStudyAssistant.Wpf.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:FlashcardsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📇 Thẻ Ghi Nhớ Ôn Tập (Flashcards)" Style="{StaticResource Header1TextStyle}" />
            <TextBlock Text="Ôn tập ngắt quãng (Spaced Repetition) giúp ghi nhớ kiến thức lâu hơn cho kỳ thi" 
                       Style="{StaticResource SubtextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Card Reviewer (Left) -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Deck / Group Selection Chips Bar -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                        BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" 
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="📂 Nhóm môn học:" FontWeight="Bold" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding GroupItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding GroupName}"
                                                Margin="0,0,8,0" Padding="12,5" Cursor="Hand" BorderThickness="1">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="FontSize" Value="12" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                                        CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.9" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding DisplayText}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Progress Bar & Card Counter -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" 
                        BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" 
                        CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding CurrentCard.SubjectName, FallbackValue='Môn: Chung'}" 
                                               Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{Binding ProgressText}" 
                                           FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Right" 
                                       Text="{Binding ProgressPercentage, StringFormat='{}Tiến độ ôn tập: {0:F0}%'}" 
                                       FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Progress Bar for Flashcards -->
                        <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100" Height="8" 
                                     Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource SurfaceAltBrush}" />
                    </Grid>
                </Border>

                <!-- Interactive Card Body -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"
                        Cursor="Hand" CornerRadius="16" Padding="32">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding FlipCardCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <!-- Front Face -->
                        <Grid Visibility="{Binding IsFlipped, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="MẶT TRƯỚC (CÂU HỎI / KHÁI NIỆM)" 
                                           Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <TextBlock Text="{Binding CurrentCard.Front, FallbackValue='Chưa có thẻ nào. Hãy thêm thẻ bên phải!'}" 
                                           Style="{StaticResource Header1TextStyle}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                                <TextBlock Text="💡 Nhấn vào thẻ để lật xem đáp án" 
                                           Style="{StaticResource SubtextStyle}" HorizontalAlignment="Center" Margin="0,24,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Back Face -->
                        <Grid Visibility="{Binding IsFlipped, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
                                <TextBlock Text="MẶT SAU (ĐÁP ÁN / GIẢI NGHĨA)" 
                                           Style="{StaticResource CaptionStyle}" Foreground="{StaticResource AccentSuccessBrush}" 
                                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <StackPanel helpers:MarkdownRenderer.Text="{Binding CurrentCard.Back}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Review & Rating Action Bar -->
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="◀ Thẻ trước" 
                            Command="{Binding PreviousCardCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    <!-- Flip Button (Show when NOT flipped) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="{Binding IsFlipped, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Button Content="🔄 Lật Thẻ Xem Đáp Án" 
                                Command="{Binding FlipCardCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Padding="16,8" />
                    </StackPanel>

                    <!-- SRS Rating Buttons (Show when flipped) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="{Binding IsFlipped, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="😰 Khó (1 ngày)" Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding RateCardCommand}" CommandParameter="1" 
                                Foreground="{StaticResource AccentDangerBrush}" Margin="0,0,8,0" />
                        <Button Content="🙂 Tốt (3 ngày)" Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding RateCardCommand}" CommandParameter="3" 
                                Foreground="{StaticResource AccentWarningBrush}" Margin="0,0,8,0" />
                        <Button Content="🤩 Dễ (7 ngày)" Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding RateCardCommand}" CommandParameter="5" 
                                Background="{StaticResource AccentSuccessBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Thẻ tiếp ▶" 
                            Command="{Binding NextCardCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Grid>

            <!-- Card Management & AI Generator (Right Sidebar) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- AI Generator Box -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="⚡ AI Tự Tạo Flashcard" Style="{StaticResource Header3TextStyle}" Margin="0,0,0,8" />
                            <TextBlock Text="Nhập chủ đề hoặc tên bài học, AI sẽ tự động sinh các thẻ quan trọng:" 
                                       Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                            <TextBox Text="{Binding AiGenerateTopic, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10" />
                            <Button Content="✨ Tạo Flashcards Bằng AI" 
                                    Command="{Binding GenerateCardsWithAiCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    IsEnabled="{Binding IsGeneratingCards, Converter={StaticResource InverseBooleanConverter}}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- Manual Card Form -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="➕ Thêm Thẻ Mới Thủ Công" Style="{StaticResource Header3TextStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="Môn học:" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewSubject, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />

                            <TextBlock Text="Mặt trước (Câu hỏi):" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewFront, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,8" />

                            <TextBlock Text="Mặt sau (Đáp án):" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewBack, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,12" />

                            <Button Content="Lưu Thẻ" Command="{Binding AddCardCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
