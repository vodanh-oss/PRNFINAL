<UserControl x:Class="SmartStudyAssistant.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SmartStudyAssistant.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="⚙️ Cấu Hình Nền Tảng AI &amp; Bảo Mật API Key" Style="{StaticResource Header1TextStyle}" />
            <TextBlock Text="Toàn bộ API Key được mã hóa an toàn bằng Windows DPAPI và lưu trữ trực tiếp trên máy của bạn" 
                       Style="{StaticResource SubtextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Providers List (Left) -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CÁC NHÀ CUNG CẤP AI" Style="{StaticResource Header3TextStyle}" Margin="0,0,0,12" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Providers}" 
                             SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" 
                                        BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Name & Default Badge -->
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <Border HorizontalAlignment="Right" Background="{StaticResource PrimaryBrush}" 
                                                    CornerRadius="4" Padding="6,2"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="MẶC ĐỊNH" Foreground="#FFFFFF" FontSize="9.5" FontWeight="Bold" />
                                            </Border>
                                        </Grid>

                                        <!-- Model name -->
                                        <TextBlock Grid.Row="1" Text="{Binding ModelName}" 
                                                   Style="{StaticResource CaptionStyle}" Margin="0,3,0,6" />

                                        <!-- Test status -->
                                        <TextBlock Grid.Row="2" Text="{Binding TestStatus}" 
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Provider Detail & Edit Card (Right) -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedProvider.DisplayName, StringFormat='{}Cấu hình: {0}'}" 
                                   Style="{StaticResource Header2TextStyle}" Margin="0,0,0,6" />
                        <TextBlock Text="Nhập API Key và tùy chỉnh Endpoint / Model ID phù hợp với tài khoản của bạn" 
                                   Style="{StaticResource SubtextStyle}" Margin="0,0,0,20" />

                        <!-- API Key -->
                        <TextBlock Text="API Key:" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding SelectedProvider.ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBoxStyle}" 
                                 FontFamily="{StaticResource MonospaceFontFamily}" Margin="0,0,0,16" />

                        <!-- Model Name -->
                        <TextBlock Text="Model Name (Mã mô hình):" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding SelectedProvider.ModelName, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16" />

                        <!-- Base URL -->
                        <TextBlock Text="Base URL Endpoint:" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding SelectedProvider.BaseUrl, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,24" />

                        <!-- Action Buttons -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <!-- Test Connection -->
                            <Button Content="🔍 Kiểm Tra Kết Nối (Ping)" 
                                    Command="{Binding TestConnectionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Margin="0,0,10,10" />

                            <!-- Set as default -->
                            <Button Content="⭐ Đặt Làm Mặc Định" 
                                    Command="{Binding SetAsDefaultCommand}"
                                    CommandParameter="{Binding SelectedProvider}"
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Margin="0,0,10,10" />

                            <!-- Save -->
                            <Button Content="💾 Lưu Cấu Hình (DPAPI)" 
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Margin="0,0,10,10" />
                        </WrapPanel>

                        <!-- Notification / Status Banner -->
                        <Border Background="{StaticResource SurfaceAltBrush}" 
                                BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="TRẠNG THÁI KIỂM TRA:" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding GlobalStatusMessage, FallbackValue='Chưa kiểm tra. Hãy nhấn nút để thử kết nối.'}" 
                                           TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
