<UserControl x:Class="SmartStudyAssistant.Wpf.Views.PomodoroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SmartStudyAssistant.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PomodoroViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="⏱️ Đồng Hồ Tập Trung Pomodoro" Style="{StaticResource Header1TextStyle}" />
            <TextBlock Text="Kỹ thuật Pomodoro giúp duy trì năng lượng và độ tập trung cao độ trong suốt buổi học" 
                       Style="{StaticResource SubtextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Main Timer Card (Center) -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"
                MaxWidth="560" MaxHeight="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36">
            <StackPanel HorizontalAlignment="Center">
                <!-- Mode Switchers -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,28">
                    <Button Content="🎯 Tập Trung (25p)" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:PomodoroMode.Work}" Margin="0,0,8,0" />
                    <Button Content="☕ Nghỉ Ngắn (5p)" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:PomodoroMode.ShortBreak}" Margin="0,0,8,0" />
                    <Button Content="🛋️ Nghỉ Dài (15p)" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:PomodoroMode.LongBreak}" />
                </StackPanel>

                <!-- Current Mode Title -->
                <TextBlock Text="{Binding ModeTitle}" Style="{StaticResource Header3TextStyle}" 
                           Foreground="{StaticResource PrimaryHoverBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />

                <!-- Big Countdown Display -->
                <Border Width="220" Height="220" CornerRadius="110" 
                        Background="{StaticResource SurfaceAltBrush}" 
                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="4"
                        HorizontalAlignment="Center" Margin="0,0,0,28">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeDisplay}" 
                                   FontFamily="{StaticResource MonospaceFontFamily}"
                                   FontSize="52" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   HorizontalAlignment="Center" />
                        <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="4" Width="120"
                                     Foreground="{StaticResource AccentSuccessBrush}" 
                                     Background="Transparent" BorderThickness="0" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Control Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse, FallbackValue='Bắt đầu ▶'}" 
                            Command="{Binding StartPauseCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Padding="28,12" FontSize="15" Margin="0,0,12,0" />

                    <Button Content="Tạm dừng ⏸" 
                            Command="{Binding StartPauseCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="28,12" FontSize="15" Margin="0,0,12,0" />

                    <Button Content="Đặt lại ⟳" 
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="20,12" FontSize="14" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Stats Bottom Bar -->
        <Grid Grid.Row="2" MaxWidth="560" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="PHIÊN HỌC HÔM NAY" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding CompletedWorkSessionsToday, StringFormat='{}{0} phiên'}" 
                               Style="{StaticResource Header2TextStyle}" Foreground="{StaticResource PrimaryHoverBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="TỔNG THỜI GIAN TẬP TRUNG" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding TotalFocusMinutesToday, StringFormat='{}{0} phút'}" 
                               Style="{StaticResource Header2TextStyle}" Foreground="{StaticResource AccentSuccessBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
