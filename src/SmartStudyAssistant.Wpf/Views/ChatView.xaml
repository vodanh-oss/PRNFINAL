<UserControl x:Class="SmartStudyAssistant.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SmartStudyAssistant.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sessions Sidebar (Left) -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="+ Phiên Học Mới" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding CreateNewSessionCommand}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,14" />

                <TextBlock Grid.Row="1" Text="LỊCH SỬ ÔN TẬP" 
                           Style="{StaticResource CaptionStyle}" 
                           FontWeight="SemiBold" Margin="4,0,0,8" />

                <ListBox Grid.Row="2" ItemsSource="{Binding Sessions}" 
                         SelectedItem="{Binding CurrentSession, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceAltBrush}" 
                                    BorderBrush="{StaticResource SurfaceBorderBrush}" 
                                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding LastModifiedAt, StringFormat='{}{0:dd/MM HH:mm}'}" 
                                                   Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" 
                                            Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}"
                                            Cursor="Hand" Padding="4" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Main Chat Area (Right) -->
        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header & Controls -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock Text="{Binding CurrentSession.Title, FallbackValue='Phiên ôn tập'}" 
                                   Style="{StaticResource Header2TextStyle}" />
                        <TextBlock Text="Đặt câu hỏi, tóm tắt hoặc yêu cầu AI giải thích dựa trên tài liệu bài giảng" 
                                   Style="{StaticResource SubtextStyle}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- RAG Toggle -->
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="16" Padding="10,4" Margin="0,0,12,0">
                            <CheckBox IsChecked="{Binding IsRagEnabled, Mode=TwoWay}" 
                                      VerticalAlignment="Center" Cursor="Hand">
                                <TextBlock Text="🔍 Tra cứu Slide (RAG)" Foreground="{StaticResource TextPrimaryBrush}" 
                                           FontWeight="Medium" FontSize="12" Margin="4,0,0,0" />
                            </CheckBox>
                        </Border>

                        <!-- Provider Badge -->
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="{Binding CurrentProviderName, StringFormat='⚡ {0}'}" 
                                       Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Messages List -->
            <ScrollViewer Grid.Row="1" Margin="20,10,20,10" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MaxWidth="720" Margin="0,8" Padding="14,12" CornerRadius="10"
                                    HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToAlignmentConverter}}"
                                    Background="{Binding Role, Converter={StaticResource RoleToBackgroundConverter}}">
                                <StackPanel>
                                    <!-- Role & Timestamp header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Role, StringFormat='{}{0}:'}" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" 
                                                   Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>

                                    <!-- Content -->
                                    <TextBox Text="{Binding Content, Mode=OneWay}" 
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="13.5" />

                                    <!-- Citations Bar (For Assistant) -->
                                    <StackPanel Margin="0,8,0,0" 
                                                Visibility="{Binding Citations.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Nguồn tài liệu tham khảo:" Style="{StaticResource CaptionStyle}" 
                                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Citations}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding BadgeText}" 
                                                            Command="{Binding DataContext.InspectCitationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="{StaticResource CitationBadgeBrush}"
                                                            Foreground="{StaticResource CitationBadgeTextBrush}"
                                                            BorderThickness="0" Padding="8,4" Margin="0,0,6,6"
                                                            FontSize="11" FontWeight="Medium" Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Action Bar (Save to Note) -->
                                    <Button Content="💾 Lưu thành Ghi chú" 
                                            Command="{Binding DataContext.SaveAsNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" 
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="11" Cursor="Hand" HorizontalAlignment="Right" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Citation Drawer / Modal Popup -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"
                    CornerRadius="12" Margin="40,20,40,20" Padding="16"
                    Visibility="{Binding IsCitationModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    VerticalAlignment="Bottom">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MaxHeight="180" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖 " FontSize="14" />
                            <TextBlock Text="{Binding InspectedCitation.BadgeText}" FontWeight="SemiBold" 
                                       Foreground="{StaticResource CitationBadgeTextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding InspectedCitation.SimilarityScore, StringFormat=' (Độ khớp: {0:P0})'}" 
                                       Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CloseCitationModalCommand}" 
                                HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextPrimaryBrush}" Cursor="Hand" Padding="6" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding InspectedCitation.Snippet}" IsReadOnly="True" TextWrapping="Wrap"
                                 Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0" Padding="10" FontSize="12.5" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Prompt Templates Chips Bar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,0,20,8">
                <Button Content="📝 Tóm tắt bài học" Style="{StaticResource ChipButtonStyle}" 
                        Command="{Binding UsePromptTemplateCommand}" CommandParameter="summary" Margin="0,0,6,0" />
                <Button Content="💡 Giải thích khái niệm" Style="{StaticResource ChipButtonStyle}" 
                        Command="{Binding UsePromptTemplateCommand}" CommandParameter="explain" Margin="0,0,6,0" />
                <Button Content="🌐 Dịch học thuật" Style="{StaticResource ChipButtonStyle}" 
                        Command="{Binding UsePromptTemplateCommand}" CommandParameter="translate" Margin="0,0,6,0" />
                <Button Content="❓ Tạo 5 câu trắc nghiệm" Style="{StaticResource ChipButtonStyle}" 
                        Command="{Binding UsePromptTemplateCommand}" CommandParameter="quiz" Margin="0,0,6,0" />
                <Button Content="📇 Sinh Flashcards" Style="{StaticResource ChipButtonStyle}" 
                        Command="{Binding UsePromptTemplateCommand}" CommandParameter="flashcards" />
            </StackPanel>

            <!-- Bottom Input Bar -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}"
                             AcceptsReturn="True" MaxHeight="100" MinHeight="42"
                             VerticalContentAlignment="Center" Margin="0,0,10,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding SendMessageCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1" Content="Gửi ➔" 
                            Command="{Binding SendMessageCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="18,10" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
