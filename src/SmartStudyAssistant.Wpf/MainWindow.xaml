<Window x:Class="SmartStudyAssistant.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SmartStudyAssistant.Wpf.Views"
        xmlns:vm="clr-namespace:SmartStudyAssistant.Wpf.ViewModels"
        xmlns:core="clr-namespace:SmartStudyAssistant.Core.Models;assembly=SmartStudyAssistant.Core"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Width="1260" Height="820"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <views:DocumentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FlashcardsViewModel}">
            <views:FlashcardsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PomodoroViewModel}">
            <views:PomodoroView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgressViewModel}">
            <views:ProgressView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Logo / App Title -->
                <Border Grid.Row="0" Padding="20,24,20,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎓" FontSize="24" Margin="0,0,10,0" />
                            <TextBlock Text="SmartStudy" Style="{StaticResource Header2TextStyle}" Foreground="#FFFFFF" />
                        </StackPanel>
                        <TextBlock Text="AI Study &amp; RAG Assistant" Style="{StaticResource CaptionStyle}" Margin="34,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Navigation Tabs List -->
                <StackPanel Grid.Row="1" Margin="12,10,12,10">
                    <!-- Chat & RAG -->
                    <Button Content="💬  AI Chat &amp; RAG" 
                            Command="{Binding NavigateCommand}" CommandParameter="Chat"
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" />

                    <!-- Documents & Slides -->
                    <Button Content="📚  Tài Liệu &amp; Slide" 
                            Command="{Binding NavigateCommand}" CommandParameter="Documents"
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" />

                    <!-- Flashcards -->
                    <Button Content="📇  Thẻ Flashcards" 
                            Command="{Binding NavigateCommand}" CommandParameter="Flashcards"
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" />

                    <!-- Pomodoro -->
                    <Button Content="⏱️  Đồng Hồ Pomodoro" 
                            Command="{Binding NavigateCommand}" CommandParameter="Pomodoro"
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" />

                    <!-- Progress & Checklist -->
                    <Button Content="📊  Tiến Độ Môn Học" 
                            Command="{Binding NavigateCommand}" CommandParameter="Progress"
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" />

                    <!-- Settings -->
                    <Button Content="⚙️  Cấu Hình Nền Tảng" 
                            Command="{Binding NavigateCommand}" CommandParameter="Settings"
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" />
                </StackPanel>

                <!-- Bottom Sidebar Controls: Provider Switcher -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" 
                        BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="NỀN TẢNG AI ĐANG DÙNG:" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,6" />

                        <!-- Quick Switcher Buttons -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Gemini" 
                                    Command="{Binding SwitchProviderCommand}" CommandParameter="{x:Static core:AiProviderType.Gemini}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="6,4" FontSize="11" Margin="0,0,3,0" />
                            <Button Grid.Column="1" Content="OpenAI" 
                                    Command="{Binding SwitchProviderCommand}" CommandParameter="{x:Static core:AiProviderType.OpenAi}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="6,4" FontSize="11" Margin="3,0,0,0" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Claude" 
                                    Command="{Binding SwitchProviderCommand}" CommandParameter="{x:Static core:AiProviderType.Claude}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="6,4" FontSize="11" Margin="0,0,3,0" />
                            <Button Grid.Column="1" Content="Groq/Ollama" 
                                    Command="{Binding SwitchProviderCommand}" CommandParameter="{x:Static core:AiProviderType.Groq}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="6,4" FontSize="11" Margin="3,0,0,0" />
                        </Grid>

                        <TextBlock Text="{Binding ActiveProviderType, StringFormat='Đang hoạt động: {0}'}" 
                                   Style="{StaticResource CaptionStyle}" Foreground="{StaticResource AccentSuccessBrush}" 
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Content Area: Swappable Dynamic View (Guaranteed 1 active view, never stacks) -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>
